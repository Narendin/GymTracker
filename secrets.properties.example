# Скопируйте этот файл в secrets.properties (он в .gitignore) и заполните своими значениями.

# Идентификатор приложения на телефоне: данные приложения привязаны к нему.
applicationId=com.example.gymtracker

# Релизный ключ. Без этих четырёх строк релизная сборка остаётся неподписанной
# и на телефон не устанавливается. Путь — абсолютный, файл вне проекта.
signing.keystore=<путь к ключу>
signing.storePassword=пароль_к_файлу
signing.keyAlias=имя_ключа
signing.keyPassword=пароль_к_ключу
